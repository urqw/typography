/*
The file encoding is UTF-8 (without BOM)
*/

:start
urqw_game_lang = "en"
pln one .... three...
pln - one - two-three
pln ---one--two-- three
pln 1-2 123-45-67
pln -5 + 2 = -3
pln su­per­ca­lif­ra­gil­is­tic­ex­pi­ali­do­cious
text = "(C) (P) (R) (TM)"
urqw_typography_off = true
pln Text without transformations: #text$
urqw_typography_off = false
pln #text$
text = '"one "two" three".'
text_en = Typography(text, "en")
pln English text: <span lang="en">#text_en$</span>
text = '"один "два" три".'
text_ru = Typography(text, "ru")
pln Russian text: <span lang="ru">#text_ru$</span>
btn be, Belarusian (be)
btn en, English (en)
btn en-uk, English (United Kingdom / Great Britain) (en-UK / en-GB)
btn en-us, English (United States) (en-US)
btn fr, French (fr)
btn de, German (de)
btn it, Italian (it)
btn ru, Russian (ru)
btn es, Spanish (es)
btn uk, Ukrainian (uk)
end

:be
urqw_game_lang = "be"
pln ЁЙ-Ў, ёй-ў
pln "адзін "два" тры".
pln камп'ютар
btn start, "Назад..."
end

:en
urqw_game_lang = "en"
pln "one "two" three".
pln UrqW's plugin
btn start, "Back..."
end

