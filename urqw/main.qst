:fr
urqw_game_lang = "fr"
pln L'UrqW permet de créer des jeux textuels.
pln Un ; deux ! Trois ? 100 % : quatre.
pln Un ; deux ! Trois ? 100 % : quatre.
pln « un “ deux ” trois ».
pln "un "deux" trois".
btn start, "Retour..."
end

:de
urqw_game_lang = "de"
pln 25 % und 50 %
pln "eins "zwei" drei".
pln Felix' Schwester
btn start, "Zurück..."
end

:it
urqw_game_lang = "it"
pln L'amico ha un'idea.
pln "uno "due" tre".
